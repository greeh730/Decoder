    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<color=#00FFAA><b>\u041D\u0410\u0412\u0418\u0413\u0410\u0426\u0418\u042F \u0418 \u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415:</b></color>\n\u2022 [\u0421\u0442\u0440\u0435\u043B\u043A\u0438 \u0412\u0432\u0435\u0440\u0445 / \u0412\u043D\u0438\u0437] \u2014 \u0412\u044B\u0431\u043E\u0440 \u0444\u0430\u0439\u043B\u0430 \u0432 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0435 \u0431\u0430\u0437\u044B\n\u2022 [Tab]                  \u2014 \u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043F\u0430\u043D\u0435\u043B\u0435\u0439 (C: \u0431\u0430\u0437\u0430 / A: \u043A\u0430\u0440\u0442\u0440\u0438\u0434\u0436)\n\u2022 [F3 / 3] \u0438\u043B\u0438 [Enter]   \u2014 \u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u044B / \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\n\u2022 [F5 / 5]               \u2014 \u041F\u0435\u0440\u0435\u043A\u0430\u0447\u043A\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0444\u0430\u0439\u043B\u0430 \u043D\u0430 \u043A\u0430\u0440\u0442\u0440\u0438\u0434\u0436\n\u2022 [F8 / 8]               \u2014 \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u0434\u0438\u0441\u043A\u043E\u0432\n\u2022 [F10 / 10 / Esc]       \u2014 \u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u044D\u043A\u0440\u0430\u043D \u042D\u0412\u041C\n\n<color=#FFCC00><b>\u041F\u0420\u0410\u0412\u0418\u041B\u0410 \u0422\u0415\u041F\u041B\u041E\u0412\u041E\u0413\u041E \u0420\u0415\u0416\u0418\u041C\u0410 \u0414\u0418\u0421\u041A\u0410:</b></color>\n\u0412\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0435\u0440\u0435\u043A\u0430\u0447\u043A\u0438 \u0434\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u0440\u0442\u0440\u0438\u0434\u0436 \u0432 \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C\u0435 \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0435\u0442\u0441\u044F!\n\u041F\u0440\u0438 75\xB0C \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435\u0441\u044C \u043A \u0437\u0430\u043C\u0435\u043D\u0435, \u043F\u0440\u0438 90\xB0C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438\u0437\u0432\u043B\u0435\u043A\u0438\u0442\u0435 \u0434\u0438\u0441\u043A,\n\u0438\u043D\u0430\u0447\u0435 \u0434\u0430\u043D\u043D\u044B\u0435 \u0431\u0443\u0434\u0443\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u044B \u0442\u043E\u043A\u043E\u043C \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0438."
