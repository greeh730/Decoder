  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.85, g: 0.98, b: 0.9, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 27769520a65bf63438642e60a67319af, type: 3}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "<size=20><color=#66CCAA>\u041A\u041E\u041C\u041C\u0423\u0422\u0410\u0426\u0418\u041E\u041D\u041D\u0410\u042F \u041F\u0410\u041D\u0415\u041B\u042C \u0421\u0415\u0422\u0418: \u041F\u0415\u0420\u0415\u0414\u0410\u0422\u0427\u0418\u041A [A] \u2500\u2500\u2500\u2500\u2500\u25BA \u0421\u0415\u0420\u0412\u0415\u0420 [B]</color></size>\n\n<b><color=#FFFF00>\u25BA </color></b><color=#FFFF88>[1] \u041A\u0410\u041D\u0410\u041B I (\u0421\u0415\u0412\u0415\u0420\u041D\u0410\u042F \u041C\u0410\u0413\u0418\u0421\u0422\u0420\u0410\u041B\u042C):    </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: U=220\u0412, f=50\u0413\u0446, \u0417\u0430\u0442\u0443\u0445\u0430\u043D\u0438\u0435: 0.8\u0434\u0411  [\u0418\u0421\u041F\u0420\u0410\u0412\u0415\u041D, \u041E\u0411\u0420\u042B\u0412 \u0426\u0415\u041F\u0418]</color>\n  <color=#AACCBB>[2] \u041A\u0410\u041D\u0410\u041B II (\u0426\u0415\u041D\u0422\u0420\u0410\u041B\u042C\u041D\u042B\u0419 \u041A\u0410\u0411\u0415\u041B\u042C):     </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: U=0\u0412, \u041A\u0417 \u041D\u0410 \u041A\u041E\u0420\u041F\u0423\u0421                [\u0410\u0412\u0410\u0420\u0418\u042F: \u0423\u0422\u0415\u0427\u041A\u0410 \u0422\u041E\u041A\u0410 \u041D\u0410 \u0417\u0415\u041C\u041B\u042E!]</color>\n  <color=#AACCBB>[3] \u041A\u0410\u041D\u0410\u041B III (\u042E\u0416\u041D\u042B\u0419 \u0420\u0415\u0422\u0420\u0410\u041D\u0421\u041B\u042F\u0422\u041E\u0420):    </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: \u0394\u03C6=180\xB0, \u041F\u0420\u041E\u0422\u0418\u0412\u041E\u0424\u0410\u0417\u0410              [\u0421\u0411\u041E\u0419: \u0414\u0415\u0421\u0422\u0420\u0423\u041A\u0422\u0418\u0412\u041D\u0410\u042F \u0424\u0410\u0417\u0410!]</color>\n  <color=#AACCBB>[4] \u041A\u0410\u041D\u0410\u041B IV (\u041E\u041F\u0422\u0418\u0427\u0415\u0421\u041A\u0418\u0419 \u0412\u041E\u041B\u041D\u041E\u0412\u041E\u0414):    </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: \u041B\u0430\u0437\u0435\u0440 1310\u043D\u043C, \u0417\u0430\u0442\u0443\u0445\u0430\u043D\u0438\u0435: 0.15\u0434\u0411   [\u0418\u0421\u041F\u0420\u0410\u0412\u0415\u041D, \u0428\u041B\u042E\u0417 \u0417\u0410\u041A\u0420\u042B\u0422]</color>\n  <color=#AACCBB>[5] \u041A\u0410\u041D\u0410\u041B V (\u0424\u0415\u0420\u0420\u0418\u0422\u041E\u0412\u042B\u0419 \u0414\u0420\u041E\u0421\u0421\u0415\u041B\u042C):     </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: I=48\u0410, \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430: 110\xB0C         [\u041F\u0415\u0420\u0415\u0413\u0420\u0415\u0412: \u0420\u0418\u0421\u041A \u0412\u041E\u0417\u0413\u041E\u0420\u0410\u041D\u0418\u042F!]</color>\n  <color=#AACCBB>[6] \u041A\u0410\u041D\u0410\u041B VI (\u0420\u0415\u0417\u0415\u0420\u0412\u041D\u0410\u042F \u0412\u0418\u0422\u0410\u042F \u041F\u0410\u0420\u0410):   </color> <color=#888888>[\u25CB \u0412\u042B\u041A\u041B]</color>\n     <color=#669988>\u0414\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430: R=600 \u041E\u043C, \u042D\u043A\u0440\u0430\u043D \u0437\u0430\u0437\u0435\u043C\u043B\u0435\u043D          [\u0418\u0421\u041F\u0420\u0410\u0412\u0415\u041D, \u041E\u0411\u0420\u042B\u0412 \u0426\u0415\u041F\u0418]</color>\n\n<color=#00AA77>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n  \u0421\u0422\u0410\u0422\u0423\u0421 \u0428\u0418\u041D\u042B: <color=#FFCC00>\u25CB \u0426\u0415\u041B\u041E\u0421\u0422\u041D\u041E\u0421\u0422\u042C \u041B\u0418\u041D\u0418\u0418: 0% (0/3 \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u0445 \u043A\u0430\u043D\u0430\u043B\u043E\u0432)</color>\n\n<color=#FFFF66>[1..6 / \u0412\u0412\u0415\u0420\u0425 / \u0412\u041D\u0418\u0417] \u041A\u0430\u043D\u0430\u043B  \u2502  [\u041F\u0420\u041E\u0411\u0415\u041B] \u0412\u041A\u041B / \u0412\u042B\u041A\u041B  \u2502  [ENTER] \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C  \u2502  [N] \u0417\u0430\u043F\u0438\u0441\u043A\u0430</color>"
