    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.15
  m_Text: "<size=20><b><color=#FFCC00>/// WORK IN PROGRESS ///</color></b></size>\n<size=15><color=#88DDCC>\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0434\u0435\u0448\u0438\u0444\u0440\u0430\u0442\u043E\u0440\u0430 \u0432 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435</color></size>\n<color=#00FFAA>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\n<b>\u0421\u0422\u0410\u0422\u0423\u0421 \u041F\u041E\u0414\u0421\u0418\u0421\u0422\u0415\u041C:</b>\n\u2022 \u041C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C \xAB\u0412\u0435\u043A\u0442\u043E\u0440-1\xBB: <color=#00FF88>[ \u041E\u041D\u041B\u0410\u0419\u041D ]</color>\n\u2022 \u041C\u0430\u0433\u043D\u0438\u0442\u043D\u0430\u044F \u043B\u0435\u043D\u0442\u0430: <color=#00FF88>[ \u0417\u0410\u0413\u0420\u0423\u0416\u0415\u041D\u0410 ]</color>\n\u2022 \u0418\u043C\u043F\u0443\u043B\u044C\u0441\u043D\u044B\u0439 \u0440\u0430\u0434\u0430\u0440: <color=#00FF88>[ \u0410\u041A\u0422\u0418\u0412\u0415\u041D ]</color>\n\u2022 \u0411\u043B\u043E\u043A \u0434\u0435\u0448\u0438\u0444\u0440\u0430\u0446\u0438\u0438: <color=#FFAA33>[ \u0412 \u0420\u0410\u0417\u0420\u0410\u0411\u041E\u0422\u041A\u0415 ]</color>\n\n<b>\u041F\u0420\u041E\u0413\u0420\u0415\u0421\u0421 \u041C\u041E\u041D\u0422\u0410\u0416\u0410:</b>\n<color=#FFCC00>[\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2591\u2591\u2591\u2591\u2591\u2591] 68%</color>\n\n<color=#FFFF66><b>\u0413\u041E\u0420\u042F\u0427\u0418\u0415 \u041A\u041B\u0410\u0412\u0418\u0428\u0418:</b></color>\n\u2022 <b>[1]</b> \u2014 \u0414\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0438 \u0437\u0430\u0434\u0430\u0447\u0438\n\u2022 <b>[2]</b> \u2014 \u0421\u0442\u0430\u0442\u0443\u0441 \u043C\u043E\u0434\u0443\u043B\u0435\u0439 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u0430\n\u2022 <b>[3]</b> \u2014 \u0422\u0435\u0441\u0442 \u0440\u0430\u0437\u0432\u0435\u0440\u0442\u043A\u0438 \u042D\u041B\u0422\n\u2022 <b>[4]</b> \u2014 \u0421\u0432\u0435\u0442 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438\n\u2022 <b>[ESC / F]</b> \u2014 \u041E\u0442\u043E\u0439\u0442\u0438 \u043E\u0442 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430"
